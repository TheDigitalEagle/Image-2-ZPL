<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SixLabors.ImageSharp 3.x ships only a net6.0 target (no netstandard2.0
         asset), so netstandard2.0 is dropped here unlike the other adapter. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Image2ZPL.ImageSharp</PackageId>
    <Description>ImageSharp adapter for Image2ZPL. Converts an ImageSharp Image into a ZPL II graphic field. Note that SixLabors.ImageSharp is distributed under the Six Labors Split License, which is not the MIT license that Image2ZPL itself uses.</Description>
    <PackageTags>zpl;zebra;label;printing;imagesharp</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <ProjectReference Include="../Image2ZPL/Image2ZPL.csproj" />
  </ItemGroup>
</Project>
